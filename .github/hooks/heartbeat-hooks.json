{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "./.github/hooks/scripts/session-start.sh",
        "powershell": "./.github/hooks/scripts/session-start.ps1",
        "cwd": ".",
        "timeoutSec": 30
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "./.github/hooks/scripts/session-end.sh",
        "powershell": "./.github/hooks/scripts/session-end.ps1",
        "cwd": ".",
        "timeoutSec": 30
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "./.github/hooks/scripts/user-prompt.sh",
        "powershell": "./.github/hooks/scripts/user-prompt.ps1",
        "cwd": ".",
        "timeoutSec": 30
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "./.github/hooks/scripts/pre-tool-use.sh",
        "powershell": "./.github/hooks/scripts/pre-tool-use.ps1",
        "cwd": ".",
        "timeoutSec": 30
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "./.github/hooks/scripts/post-tool-use.sh",
        "powershell": "./.github/hooks/scripts/post-tool-use.ps1",
        "cwd": ".",
        "timeoutSec": 30
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "bash": "./.github/hooks/scripts/error-occurred.sh",
        "powershell": "./.github/hooks/scripts/error-occurred.ps1",
        "cwd": ".",
        "timeoutSec": 30
      }
    ]
  }
}
